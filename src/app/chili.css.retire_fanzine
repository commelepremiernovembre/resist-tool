/* ==========================================================================
   Resist ! — look « Fanzine » (classe .chili, cookie resist_theme=chili).
   Sans le cookie, rien ne change. Fanzine photocopié et collé à la main :
   papier journal gris, noir et blanc, titres découpés, scotch, machine à
   écrire, un seul accent au feutre rouge.
   ========================================================================== */
.chili {
  --zn-ink: #141414;
  --zn-paper: #ECEAE4;
  --zn-red: #D7261E;
  --zn-tape: rgba(236, 222, 160, .78);
}

/* Papier photocopié : grain + traînées de toner */
.chili body {
  background-color: var(--zn-paper);
  background-image:
    repeating-linear-gradient(0deg, rgba(0, 0, 0, .025) 0 1px, transparent 1px 3px),
    radial-gradient(rgba(0, 0, 0, .10) .8px, transparent 1px);
  background-size: auto, 5px 5px;
  color: var(--zn-ink);
}

/* Titres : lettres découpées dans un journal, collées sur bandes noires */
.chili h1, .chili h2, .chili .font-display {
  font-family: var(--font-chili), var(--font-display), system-ui, sans-serif !important;
  font-style: normal !important;
  font-weight: 400 !important;
  text-transform: uppercase;
  letter-spacing: .02em;
}
.chili main h1 {
  width: fit-content;
  max-width: 100%;
  background: var(--zn-ink);
  color: #fff !important;
  padding: .12em .4em .08em;
  line-height: 1.05;
  transform: rotate(-1deg);
  box-shadow: 3px 4px 0 rgba(0, 0, 0, .22);
}
.chili h2 { font-size: 1.2em; letter-spacing: .04em; }

/* Texte courant et étiquettes à la machine à écrire */
.chili p, .chili label, .chili .label, .chili li, .chili td, .chili th {
  font-family: var(--font-zine), ui-monospace, monospace;
}

/* Couleurs : tout en noir et blanc, le violet devient feutre rouge */
.chili .text-violet { color: var(--zn-red) !important; }
.chili .bg-violet { background-color: var(--zn-ink) !important; }
.chili .bg-violet-wash, .chili .bg-violet-wash\/40 { background-color: #fff !important; }
.chili .border-violet, .chili .border-violet\/50, .chili .border-violet\/40 { border-color: var(--zn-ink) !important; }
.chili .accent-violet { accent-color: var(--zn-red); }
.chili .text-moss { color: var(--zn-red) !important; }
.chili .bg-moss\/10 { background-color: #fff !important; }
.chili hr.border-violet { border-color: var(--zn-ink) !important; border-top-width: 2px !important; border-style: dashed; }

/* Logo : morceau de papier blanc découpé, scotché, souligné au feutre */
.chili a.group > span:first-child {
  background: #F1E7C4;
  color: var(--zn-ink) !important;
  padding: .02em .3em .06em;
  transform: rotate(-2.5deg);
  display: inline-block;
  box-shadow: 2px 3px 0 rgba(0, 0, 0, .25);
  clip-path: polygon(0 4%, 6% 0, 40% 3%, 72% 0, 100% 5%, 98% 50%, 100% 96%, 60% 100%, 30% 97%, 2% 100%, 0 55%);
}
.chili a.group > span.stroke-in {
  background: var(--zn-red) !important;
  height: 5px !important;
  border-radius: 3px !important;
  margin-top: 10px !important;
  transform: rotate(-2deg) skewX(-25deg);
}

/* Cartes : feuilles collées de travers, bout de scotch en haut */
.chili .card, .chili article, .chili .rounded-2xl, .chili .rounded-3xl {
  border-radius: 0 !important;
  border: 1.5px solid var(--zn-ink) !important;
  box-shadow: 3px 4px 0 rgba(0, 0, 0, .22) !important;
  background-color: #fff;
}
.chili main article { position: relative; overflow: visible !important; }
.chili main article::before {
  content: '';
  position: absolute; z-index: 2;
  top: -12px; left: 50%; width: 92px; height: 24px;
  margin-left: -46px;
  background: var(--zn-tape);
  transform: rotate(-4deg);
  box-shadow: 0 1px 2px rgba(0, 0, 0, .15);
}
.chili main article:nth-of-type(odd) { transform: rotate(-1.3deg); }
.chili main article:nth-of-type(even) { transform: rotate(1deg); }
.chili main article:nth-of-type(even)::before { transform: rotate(5deg); }

/* Illustrations : trame de photocopieuse */
.chili article > div:first-child {
  background-color: #fff;
  background-image: radial-gradient(rgba(0, 0, 0, .28) 1px, transparent 1.3px);
  background-size: 6px 6px;
  border-bottom: 1.5px solid var(--zn-ink);
}
.chili article svg { filter: grayscale(1) contrast(2); }

/* Boutons : étiquettes Dymo noires, le principal au feutre rouge */
.chili .btn-primary, .chili .btn-dark, .chili .btn-ghost, .chili button.rounded-xl, .chili a.rounded-xl {
  border-radius: 0 !important;
  border: 2px solid var(--zn-ink) !important;
  box-shadow: 3px 3px 0 var(--zn-ink) !important;
  font-family: var(--font-zine), ui-monospace, monospace;
  font-weight: 400 !important;
  text-transform: uppercase;
  letter-spacing: .06em;
  transition: transform .08s, box-shadow .08s;
}
.chili .btn-primary:active, .chili .btn-dark:active, .chili .btn-ghost:active, .chili button.rounded-xl:active {
  transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--zn-ink) !important;
}
.chili .btn-primary { background: var(--zn-red) !important; color: #fff !important; }
.chili .btn-primary:hover { background: var(--zn-ink) !important; }
.chili .btn-dark { background: var(--zn-ink) !important; color: #fff !important; }
.chili .btn-dark:hover { background: var(--zn-red) !important; }
.chili .btn-ghost { background: #fff !important; color: var(--zn-ink) !important; }

/* Champs : cases à remplir au stylo */
.chili .field, .chili input[type=text], .chili input:not([type]), .chili select, .chili textarea {
  border-radius: 0 !important;
  border: 1.5px solid var(--zn-ink) !important;
  background: #fff;
  font-family: var(--font-zine), ui-monospace, monospace;
}
.chili .field:focus, .chili input:focus, .chili select:focus, .chili textarea:focus {
  box-shadow: 3px 3px 0 var(--zn-red) !important;
}

/* Réunion : grille en gris photocopie, curseur rouge */
.chili [data-c] { filter: grayscale(1) contrast(1.3); }
.chili .range-thumb::-webkit-slider-thumb { background: var(--zn-red); border-color: var(--zn-ink); border-radius: 0; }
.chili .range-thumb::-moz-range-thumb { background: var(--zn-red); border-color: var(--zn-ink); border-radius: 0; }

/* Bas de page : tampon */
.chili main > p:last-child { color: var(--zn-ink) !important; }
.chili main > p:last-child::before { content: '✂ '; color: var(--zn-red); }

@media (max-width: 640px) {
  .chili main h1 { font-size: 8vw !important; }
}
@media (prefers-reduced-motion: reduce) {
  .chili main article { transform: none !important; }
}
